@startuml ClassDiagram
class Node {
    +List<Node> Neighbors
    +bool IsOccupied
    +Vector3 TopPosition
    +Vector3 DirectionFromOrigin
    +void ConnectTo(Node other)
    +void DisconnectFrom(Node other)
}

class Pillar {
    +PillarSize Size
}

class Bridge{
    +void Initialize(Vector3 from, Vector3 to, Vector3 upwards = default)
}

class Map {
    +static Map Instance
    +List<Node> Nodes
    +List<Pillar> Pillars
    +List<Bridge> Bridges
    +List<Node> Spawners
    +Vector3 Origin
    +abstarct Pillar StartPillar
    +virtual List<Node> FindPath(Node from, Node to, bool ignoreOccupied = false)
    +int CalcTrueDistance(Node from, Node to)
    +int CalcPathDistance(Node from, Node to)
    +void ConnectPillars(Pillar pillar1, Pillar pillar2)
    +abstract void GenerateMap()
}

class RandomSphereMap {

}

class PoissonSampler {
    +static List<Vector2> GeneratePoissonPoints(int count, float radius, (float, float) xRange, (float, float) yRange, int maxAttempts, List<Vector2> existingPoints)
}

class GeometryUtils {
    +static Vector2 ProjectOntoPlane2D(Vector3 point, Vector3 origin, Vector3 xAxis, Vector3 yAxis)
    +static bool DoIntersect(Vector2 a, Vector2 b, Vector2 c, Vector2 d)
}

class Unit {
    +Node CurrentNode
    +bool TryMoveTo(Node targetNode)
    +bool CanMoveTo(Node targetNode)
    +void MoveTo(Node targetNode)
}

class Player {
    +int Life
    +int Stamina
    +void Initialize(Node startNode)
    +void TakeDamage(int damage)
    +void RegenerateStamina(int amount)
    +void RegenerateStamina()
    +bool TrySprintTo(Node targetNode, int maxPillarDistance)
}

class Enemy {
    +void Initialize(Node startNode, Player player)
    +void Act()
}

class Pursuer {

}

class UnitManager {
    +static UnitManager Instance
    +Player Player
    +List<Enemy> Enemies
    +void InitializePlayer()
    +void SpawnWave(int count)
    +void SpawnEnemyAtRandomSpawner()
    +void SpawnEnemy(Node node)
    +void RemoveDestroyedEnemies()
}

class UnitSystem {
    +static UnitSystem Instance
    +Initialize()
}

class GameStateManager {
    +static GameStateManager Instance
    +event Action<TurnState> OnTurnChange
    +event Action<GameState> OnStateChange
    +TurnState CurrentTurn
    +GameState CurrentState
    +int TurnCount
    +bool IsPlayerTurn
    +bool IsEnemyTurn
    +bool IsIdle
    +bool IsSpecialActionState
    +void EndPlayerTurn()
    +void EndEnemyTurn()
    +void SetSpecialActionState()
    +void ResetState()
}

class InputManager {
    +static InputManager Instance
    +event System.Action<int, Vector3, GameObject> OnMouseButtonDown
    +event System.Action<HashSet<KeyCode>> OnKeyDown;
    +event System.Action<HashSet<KeyCode>> OnKey;
}

class SpecialAction {
    +bool IsActive
    +void Activate()
    +void Deactivate()
}

class Sprint {

}

class SpecialActionManager {
    +static SpecialActionManager Instance
    +void AddSpecialAction(SpecialAction action)
    +void RemoveSpecialAction(SpecialAction action)
}

class GameManager {
    +static GameManager Instance
}

Node <|-- Pillar
Node <|-- Bridge
Map <|-- RandomSphereMap

Node *-- Map
Pillar *-- Map
Bridge *-- Map
Pillar *-- RandomSphereMap
Bridge *-- RandomSphereMap
PoissonSampler *-- RandomSphereMap
GeometryUtils *-- RandomSphereMap

Unit <|-- Player
Unit <|-- Enemy
Enemy <|-- Pursuer

Player *-- Enemy
Player *-- UnitManager
Enemy *-- UnitManager

Node *--* Unit
Node *-- Player
Node *-- Enemy
Map *-- Player
Map *-- UnitManager

UnitManager *-- UnitSystem
GameStateManager *-- UnitSystem
InputManager *-- UnitSystem

SpecialAction <|-- Sprint

InputManager *-- SpecialAction
GameStateManager *-- Sprint
SpecialAction *-- SpecialActionManager

Map *-- GameManager
UnitSystem *-- GameManager
SpecialActionManager *-- GameManager
@enduml

